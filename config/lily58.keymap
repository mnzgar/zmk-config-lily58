/* Velocidad del raton/scroll para los encoders.
 *
 * ZMK mueve `velocidad * trigger-period-ms / 1000` por cada tick de 16 ms.
 * Con los valores por defecto (MOVE 600, SCRL 10) un detent del encoder, que
 * solo se mantiene pulsado unas decenas de ms, mueve menos de 1 unidad y no
 * se nota nada. Subimos la velocidad para que un solo tick ya valga un notch
 * de scroll / ~32 px de movimiento. Hay que definir antes de incluir
 * `pointing.h` (mas abajo), que es quien usa estos valores. */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 2000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 120

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include "lily58_encoders.dtsi"

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <130>;
        };

        /* Capa pegajosa: tap = &to (te quedas en la capa),
         * hold = &mo (solo mientras la mantienes).
         * Uso: &to_mo <hold>, <tap>  -> ambos son el numero de capa. */
        to_mo: to_mo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&to>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        /* Encoders como raton.
         *
         * `zmk,behavior-sensor-rotate` es el unico tipo de behavior que vale
         * en `sensor-bindings`. El primer binding es el giro horario (CW) y el
         * segundo el antihorario (CCW); CW va hacia el eje positivo: arriba en
         * vertical y derecha en horizontal.
         *
         * `tap-ms` es lo que se mantiene pulsado el binding por cada detent:
         * tiene que pasar de los 16 ms del tick de `&msc`/`&mmv`
         * (trigger-period-ms) para que se emita al menos un evento, y quedarse
         * por debajo de 32 ms para que no se emitan dos. */
        enc_scroll_v: enc_scroll_v {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <30>;
        };

        enc_scroll_h: enc_scroll_h {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
            tap-ms = <30>;
        };

        enc_move_v: enc_move_v {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_UP>, <&mmv MOVE_DOWN>;
            tap-ms = <30>;
        };

        enc_move_h: enc_move_h {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&mmv MOVE_RIGHT>, <&mmv MOVE_LEFT>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |  1  |  2  |  3  |  4  |  5  |                  |  6  |  7  |  8  |  9  |  0  |      |
// |  TAB  |  Q  |  W  |  E  |  R  |  T  |                  |  Y  |  U  |  I  |  O  |  P  | BSPC |
// │  ESC  │  A⇧ │  S⌃ │  D⌥ │  F⌘ │  G  │                  │  H  │  J⌘ │  K⌥ │  L⌃ │  Ñ⇧ │  '   │
// | MAYUS |  Z  |  X  |  C  |  V  |  B  | MUTE  |  |  ▶⏸   |  N  |  M  |  ,  |  .  |     | TOG1 |
//                     |     | SYS | NUM | SPACE |  | ENTER | SYM | NAV |     |
            display-name = "base";
            bindings = <
&trans    &kp N1        &kp N2       &kp N3      &kp N4      &kp N5                             &kp N6  &kp N7      &kp N8      &kp N9       &kp N0          &trans
&kp TAB   &kp Q         &kp W        &kp E       &kp R       &kp T                              &kp Y   &kp U       &kp I       &kp O        &kp P           &kp BSPC
&kp ESC   &hm LSHIFT A  &hm LCTRL S  &hm LALT D  &hm LGUI F  &kp G                              &kp H   &hm RGUI J  &hm RALT K  &hm RCTRL L  &hm RSHFT SEMI  &kp SQT
&kp CAPS  &kp Z         &kp X        &kp C       &kp V       &kp B       &kp C_MUTE  &kp C_PP   &kp N   &kp M       &kp COMMA   &kp DOT      &trans          &tog 1
                                     &trans      &mo 5       &to_mo 3 3  &kp SPACE   &kp ENTER  &mo 2   &to_mo 4 4  &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_NEXT C_PREV
            >;
        };

        function_layer {
// ------------------------------------------------------------------------------------------------------------
// |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |                  |  F7  |  F8  |  F9  |  F10 |  F11 | F12  |
// |  TAB  |  Q   |  W   |  E   |  R   |  T   |                  |  Y   |  U   |  I   |  O   |  P   | BSPC |
// │  ESC  │  A⇧  │  S⌃  │  D⌥  │  F⌘  │  G   │                  │  H   │  J⌘  │  K⌥  │  L⌃  │  Ñ⇧  │  '   │
// | MAYUS |  Z   |  X   |  C   |  V   |  B   |       |  |       |  N   |  M   |  ,   |  .   |      | TOG1 |
//                       |      |  SYS |  NUM | SPACE |  | ENTER |  SYM |  NAV |      |
            display-name = "func";
            bindings = <
&kp F1    &kp F2        &kp F3       &kp F4      &kp F5      &kp F6                        &kp F7  &kp F8      &kp F9      &kp F10      &kp F11         &kp F12
&kp TAB   &kp Q         &kp W        &kp E       &kp R       &kp T                         &kp Y   &kp U       &kp I       &kp O        &kp P           &kp BSPC
&kp ESC   &hm LSHIFT A  &hm LCTRL S  &hm LALT D  &hm LGUI F  &kp G                         &kp H   &hm RGUI J  &hm RALT K  &hm RCTRL L  &hm RSHFT SEMI  &kp SQT
&kp CAPS  &kp Z         &kp X        &kp C       &kp V       &kp B   &trans     &trans     &kp N   &kp M       &kp COMMA   &kp DOT      &trans          &tog 1
                                     &trans      &mo 5       &to_mo 3 3  &kp SPACE   &kp ENTER  &mo 2   &to_mo 4 4  &trans
            >;
            sensor-bindings = <&enc_scroll_v &enc_scroll_h>;
        };

        sym_layer {
// ------------------------------------------------------------------------------------------------------------
// |     |     |     |     |     |     |                  |     |     |     |     |     |     |
// |     |  ¡  |  !  |  ¿  |  ?  |  \  |                  |  ·  |  (  |  )  |  <  |  >  | DEL |
// |     |  "  |  '  |  `  |  _  |  |  |                  |  º  |  {  |  }  |  ~  |  ^  |     |
// |     |  $  |  €  |  %  |  @  |  #  |       |  |       |  ç  |  [  |  ]  |  ¬  |  &  |     |
//                   |     |     |     |       |  |       |     |     |     |
            display-name = "sym";
            bindings = <
&trans  &trans      &trans     &trans       &trans        &trans                        &trans         &trans        &trans             &trans      &trans        &trans
&trans  &kp EQL     &kp EXCL   &kp LS(EQL)  &kp LS(MINUS) &kp RA(MINUS)                 &kp HASH       &kp ASTRK     &kp LPAR           &kp NUBS    &kp LS(NUBS)  &kp DEL
&trans  &kp AT      &kp MINUS  &kp LBKT     &kp LS(FSLH)  &kp RA(N1)                    &kp GRAVE      &kp RA(SQT)   &kp RA(BACKSLASH)  &kp RA(N4)  &kp LS(LBKT)  &trans
&trans  &kp DOLLAR  &kp RA(E)  &kp PRCNT    &kp RA(N2)    &kp RA(N3)    &trans  &trans  &kp BACKSLASH  &kp RA(LBKT)  &kp RA(RBKT)       &kp RA(N6)  &kp LS(N6)    &trans
                               &trans       &trans        &trans        &trans  &trans  &trans         &trans        &trans
        };

        num_layer {
// ------------------------------------------------------------------------------------------------------------
// |     |     |     |     |     |     |                  |     |     |     |     |     |     |
// |     |     |     |     |     |     |                  |     |  7  |  8  |  9  |     | DEL |
// |     |  /  |  -  |  *  |  +  |     |                  |  ,  |  4  |  5  |  6  |     |     |
// |     |     |     |     |  =  |     |       |  |       |  .  |  1  |  2  |  3  |  0  |     |
//                   |     |     |     |       |  |       |     |     |     |
            display-name = "num";
            bindings = <
&trans    &trans      &trans     &trans        &trans       &trans                  &trans      &trans  &trans  &trans  &trans  &trans
&trans    &trans      &trans     &trans        &trans       &trans                  &trans      &kp N7  &kp N8  &kp N9  &trans  &kp DEL
&trans    &kp LS(N7)  &kp SLASH  &kp LS(RBKT)  &kp KP_PLUS  &trans                  &kp COMMA   &kp N4  &kp N5  &kp N6  &trans  &trans
&trans    &trans      &trans     &trans        &kp LS(N0)   &trans  &trans  &trans  &kp PERIOD  &kp N1  &kp N2  &kp N3  &kp N0  &trans
                                 &trans        &trans       &to 0   &trans  &trans  &trans      &trans  &trans
            >;
        };

        nav_layer {
// ------------------------------------------------------------------------------------------------------------
// |     |     |     |     |     |     |                  |     |      |     |      |      |     |
// |     |     |     |     |     |     |                  |     |      |  ↑  |      |      |     |
// |     |     |     |     |     |     |                  |     |  ←   |  ↓  |  →   |      |     |
// |     |     |     |     |     |     |       |  |       |     | HOME | END | PGUP | PGDN |     |
//                   |     |     |     |       |  |       |     |      |     |
            display-name = "nav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp UP    &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp HOME  &kp END   &kp PG_UP  &kp PG_DN  &trans
                                &trans  &trans  &trans  &trans    &trans  &trans    &to 0   &trans
            >;
            sensor-bindings = <&enc_move_v &enc_move_h>;
        };

        system_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |     |     |     |                  |     |     |     |     |            |     |
// | BTCLR | BT1 | BT2 | BT3 | BT4 | BT5 |                  |     |     |     |     | ZMK_STUDIO |     |
// |       |     |     |     |     |     |                  |     |     |     |     |            |     |
// |       |     |     |     |     |     |       |  |       |     |     |     |     |            |     |
//                     |     |     |     |       |  |       |     |     |     |
            display-name = "system";
            bindings = <
&trans      &trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans          &trans
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &studio_unlock  &trans
&trans      &trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans          &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans
                                        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

/* Para los encoders queremos velocidad constante: con aceleracion cada tick
 * del primer tramo mueve mucho menos que el maximo y el detent se queda
 * practicamente quieto. `&msc` ya usa exponente 0. */
&mmv {
    acceleration-exponent = <0>;
};
