#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "lily58_encoders.dtsi"

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <130>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |  1  |  2  |  3   |  4  |  5  |                  |  6  |  7  |  8  | 9  | 0  |      |
// |  TAB  |  Q  |  W  |  E   |  R  |  T  |                  |  Y  |  U  |  I  | O  | P  | BSPC |
// │  ESC  │  A⇧ │  S⌃ │  D⌥  │  F⌘ │  G  │                  │  H  │  J⌘ │  K⌥ │ L⌃ │ Ñ⇧ │  '   │
// | MAYUS |  Z  |  X  |  C   |  V  |  B  | MUTE  |  |       |  N  |  M  |  ,  | .  |    | TOG1 |
//                     |      | MO4 | MO3 | SPACE |  | ENTER | MO2 | MO5 |     |
            display-name = "base";
            bindings = <
&trans    &kp N1        &kp N2       &kp N3      &kp N4      &kp N5                         &kp N6  &kp N7      &kp N8      &kp N9       &kp N0          &studio_unlock
&kp TAB   &kp Q         &kp W        &kp E       &kp R       &kp T                          &kp Y   &kp U       &kp I       &kp O        &kp P           &kp BSPC
&kp ESC   &hm LSHIFT A  &hm LCTRL S  &hm LALT D  &hm LGUI F  &kp G                          &kp H   &hm RGUI J  &hm RALT K  &hm RCTRL L  &hm RSHFT SEMI  &kp SQT
&kp CAPS  &kp Z         &kp X        &kp C       &kp V       &kp B   &kp C_MUTE  &trans     &kp N   &kp M       &kp COMMA   &kp DOT      &trans          &tog 1
                                     &trans      &trans      &trans  &kp SPACE   &kp ENTER  &mo 2  &trans      &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp C_NEXT C_PREV
            >;
        };

        function_layer {
// ------------------------------------------------------------------------------------------------------------
// |  F1   | F2  | F3  | F4 | F5  | F6  |                  | F7  | F8  | F9  | F10 | F11 | F12  |
// |  TAB  |  Q  |  W  | E  |  R  |  T  |                  |  Y  |  U  |  I  |  O  |  P  | BSPC |
// │  ESC  │  A⇧ │  S⌃ │ D⌥ │  F⌘ │  G  │                  │  H  │  J⌘ │  K⌥ │  L⌃ │  Ñ⇧ │  '   │
// | MAYUS |  Z  |  X  | C  |  V  |  B  |  ▶⏸   |  |       |  N  |  M  |  ,  |  .  |     | TOG1 |
//                     |    | MO4 | MO3 | SPACE |  | ENTER | MO2 | MO5 |     |
            display-name = "func";
            bindings = <
&kp F1    &kp F2        &kp F3       &kp F4      &kp F5      &kp F6                        &kp F7  &kp F8      &kp F9      &kp F10      &kp F11         &kp F12
&kp TAB   &kp Q         &kp W        &kp E       &kp R       &kp T                         &kp Y   &kp U       &kp I       &kp O        &kp P           &kp BSPC
&kp ESC   &hm LSHIFT A  &hm LCTRL S  &hm LALT D  &hm LGUI F  &kp G                         &kp H   &hm RGUI J  &hm RALT K  &hm RCTRL L  &hm RSHFT SEMI  &kp SQT
&kp CAPS  &kp Z         &kp X        &kp C       &kp V       &kp B   &kp C_PP   &trans     &kp N   &kp M       &kp COMMA   &kp DOT      &trans          &tog 1
                                     &trans      &trans      &trans  &kp SPACE  &kp ENTER  &trans  &trans      &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_NEXT C_PREV
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        lower_layer {
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 | BT3 | BT4 | BT5 |                  |     |     |     |     |     |     |
// |       |  ¡  |  !  |  ¿  |  ?  |  \  |                  |  ·  |  (  |  )  |  <  |  >  | DEL |
// |       |  "  |  '  |  `  |  _  |  |  |                  |  º  |  {  |  }  |  ~  |  ^  |     |
// |       |  $  |  €  |  %  |  @  |  #  |       |  |       |  ç  |  [  |  ]  |  ¬  |  &  |     |
//                     |     |     |     |       |  |       |     |     |     |
            display-name = "Lower";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                   &trans         &trans    &trans    &trans     &trans     &trans
&trans      &kp EQL       &kp EXCL      &kp LS(EQL)   &kp LS(MINUS) &kp RA(MINUS)                  &kp HASH       &kp ASTRK &kp LPAR  &kp NUBS   &kp LS(NUBS)  &kp DEL
&trans      &kp AT        &kp MINUS     &kp LBKT      &kp LS(FSLH)  &kp RA(N1)                     &kp GRAVE      &kp RA(SQT) &kp RA(BACKSLASH) &kp RA(N4) &kp LS(LBKT) &trans
&trans      &kp DOLLAR    &kp RA(E)     &kp PRCNT     &kp RA(N2)    &kp RA(N3)    &trans  &trans  &kp BACKSLASH  &kp RA(LBKT) &kp RA(RBKT) &kp RA(N6) &kp LS(N6) &trans
                                        &trans        &trans        &trans        &trans  &trans  &trans         &trans    &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_NEXT C_PREV
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        raise_layer {
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |                   |      |       |       |      |       |       |
// |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
// |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
// |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
//                     |      |      |      |        |  |       |      |       |       |
            display-name = "Raise";
            bindings = <
&trans    &trans &trans &trans  &trans  &trans                       &trans      &trans    &trans    &trans   &trans    &trans
&kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                       &kp N6      &kp N7    &kp N8    &kp N9   &kp N0    &trans
&kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                       &trans      &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &trans
&kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12   &trans   &trans    &kp KP_PLUS &kp MINUS &kp EQUAL &kp LBKT &kp RBKT  &kp BSLH
                         &trans  &trans  &trans    &trans   &trans    &trans      &trans    &trans
            >;
            sensor-bindings = <
                &inc_dec_kp C_NEXT C_PREV
                &inc_dec_kp C_VOL_UP C_VOL_DN
            >;
        };

        extra_1 {
            status = "reserved";
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
